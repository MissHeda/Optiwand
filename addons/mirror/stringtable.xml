        <!-- Item -->
        <Key ID="STR_opw_mirror_Progress_Deploy">
            <English>Sliding mirror under door...</English>
        </Key>
        <!-- Item -->
        <!-- Settings -->
        <Key ID="STR_opw_mirror_SettingCategory">
            <English>Optiwand</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_AllowFreehand">
            <English>Freehand peeking</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_AllowFreehand_Description">
            <English>Allow holding the wand out to look over\na wall or round a corner.\n\nOff: doors only.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_CamHeight">
            <English>Mirror head height</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_CamHeight_Description">
            <English>How high the head rides above the floor\nat a door, in metres.\n\nLower sees under lower doors, but scrapes\nthe ground sooner.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_DefaultFov">
            <English>Starting zoom</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_DefaultFov_Description">
            <English>Where the view starts, and where R returns to.\n\nAlways pulled into the two limits above, so it\ncan never start somewhere the zoom keys\ncannot reach again.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_DeployTime">
            <English>Deploy time</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_DeployTime_Description">
            <English>Seconds spent sliding the mirror into\nposition before the picture appears.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_FreeExtend">
            <English>Freehand reach</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_FreeExtend_Description">
            <English>How much further than the starting position\nthe head can be pushed, in metres.\n\nWalls still stop it earlier.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_LockInput">
            <English>Lock other keys while peeking</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_LockInput_Description">
            <English>While the camera is out, you stand\nstill: only the Optiwand keys, radio\ntransmit, the mouse buttons and\nEscape still work.\n\nEverything else - walking, stance,\nlean, turning with the mouse, other\nmods' keybinds - is held back.\n\nOff: every key works as usual, and\nyou can move with the camera out.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_MaxDepth">
            <English>Maximum reach</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_MaxDepth_Description">
            <English>How far the head can be pushed through\na door gap, in metres.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_OffsetForward">
            <English>Camera offset, forward</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_OffsetForward_Description">
            <English>How far past the end of the wand the\ncamera sits, in metres.\n\nSet it once and leave it.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_OffsetRight">
            <English>Camera offset, sideways</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_OffsetRight_Description">
            <English>Sideways offset of the camera from the end\nof the wand, in metres.\n\nPositive is to the right.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_OffsetUp">
            <English>Camera offset, height</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_OffsetUp_Description">
            <English>Height offset of the camera from the end of\nthe wand, in metres.\n\nPositive is up.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_RequireClearance">
            <English>Require clearance</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_RequireClearance_Description">
            <English>Refuse to deploy freehand when there is no\nroom for the head, and say so on screen.\n\nOff: the mirror goes out anywhere. The head\nthen sits wherever it still fits.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_RequireItem">
            <English>Optiwand must be in hand</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_RequireItem_Description">
            <English>Only offer the mirror when an Optiwand\nis actually in hand.\n\nOff: anyone can use it empty handed.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_ZoomFar">
            <English>Zoom limit, widest</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_ZoomFar_Description">
            <English>Widest view the zoom keys can reach.\nHigher takes in the whole room but bends\nstraight lines - the fisheye look.\n\nSame value as the closest limit disables\nzooming entirely.</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_ZoomNear">
            <English>Zoom limit, closest</English>
        </Key>
        <!-- Item -->
        <Key ID="STR_opw_mirror_Setting_ZoomNear_Description">
            <English>Narrowest view the zoom keys can reach.\nLower is more magnified.</English>
        </Key>
        <!-- Item -->
    </Package>
    <!-- Item -->
</Project>
