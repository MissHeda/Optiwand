<?xml version="1.0" encoding="utf-8"?>
<Project name="Optiwand">
    <Package name="esdcam">
        <Key ID="STR_opw_esdcam_SettingCategory">
            <English>Optiwand - ESD Camera</English>
        </Key>

        <Key ID="STR_opw_esdcam_Acquire_Prompt">
            <English>HOLD  LMB  TO  ACQUIRE</English>
        </Key>
        <Key ID="STR_opw_esdcam_Acquire_Progress">
            <English>ACQUIRING   %1%</English>
        </Key>
        <Key ID="STR_opw_esdcam_Setting_RequireAcquire">
            <English>Hold to acquire picture</English>
        </Key>
        <Key ID="STR_opw_esdcam_Setting_RequireAcquire_Description">
            <English>Hold the left mouse button to bring the\npicture up.\n\nOff: the picture is there the moment the\ncamera is deployed.</English>
        </Key>
        <Key ID="STR_opw_esdcam_Setting_AcquireTime">
            <English>Acquire time</English>
        </Key>
        <Key ID="STR_opw_esdcam_Setting_AcquireTime_Description">
            <English>Seconds of holding before the picture\nappears.\n\nLetting go drains twice as fast, so tapping\ngets you nowhere.</English>
        </Key>

        <Key ID="STR_opw_esdcam_Camera_DisplayName">
            <English>SD Inspection Camera</English>
        </Key>
        <Key ID="STR_opw_esdcam_Camera_Description">
            <English>Gooseneck inspection camera for the\nSpectrum Device. Fits the muzzle slot\nin place of an antenna.\n\nAim the device to deploy it, same as the\nOptiwand. No signal tracking while fitted.</English>
        </Key>
