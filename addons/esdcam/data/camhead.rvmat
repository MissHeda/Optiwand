// Material of the camera attachment.
//
// Colour comes from camhead_co.paa, baked from the Blender materials (tools/
// blender_camhead.py, BAKE = True). The gooseneck's structure sits in camhead_nohq - the
// ribbing is procedural bump in Blender and does not exist as geometry at all, but it
// comes along once baked.
//
// Why the colour texture looks darker than the Blender render: what is baked is the base
// colour, not the lit image. The metallic impression is produced further down through
// specular - were it in the texture as well it would be in twice over in game, and the
// model would look flat and milky.
//
// To adjust: higher specular means more reflection, higher specularPower a smaller and
// harder highlight. The first number in the fresnel drives the bright rim at the
// silhouette.

class StageTI {
    texture = "a3\data_f\default_ti_ca.paa";
};

ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={0,0,0,1};
specular[]={0.14,0.145,0.155,1};
specularPower=36;
PixelShaderID="Super";
VertexShaderID="Super";

class Stage1 {
    // No leading backslash: with mainprefix z, Arma resolves "z\opw\..." but not
    // "\z\opw\...". A leading backslash here means the texture silently fails to load.
    texture = "z\opw\addons\esdcam\data\camhead_nohq.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage2 {
    texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,dt)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage3 {
    texture = "#(argb,8,8,3)color(0,0,0,0,mc)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage4 {
    // No ambient occlusion texture baked, so neutral white.
    texture = "#(argb,8,8,3)color(1,1,1,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,1};
    };
};

class Stage5 {
    // Neutral SMDI. Anyone who bakes a real specular map later hangs it in here.
    texture = "#(argb,8,8,3)color(1,1,1,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage6 {
    texture = "#(ai,64,64,1)fresnel(0.35,0.7)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};

class Stage7 {
    // Black rather than env_land_ca: a smooth tube with environment reflection tips straight
    // into chrome, most visibly on bright terrain.
    texture = "#(argb,8,8,3)color(0,0,0,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};
