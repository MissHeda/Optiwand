// Material des Kameraaufsatzes.
//
// Die Farbe kommt aus camhead_co.paa, gebacken aus den Blender-Materialien (tools/
// blender_camhead.py, BAKE = True). Die Struktur des Schwanenhalses steckt in camhead_nohq
// - die Riffelung ist in Blender prozeduraler Bump und existiert als Geometrie gar nicht,
// gebacken kommt sie trotzdem mit.
//
// Warum die Farbtextur dunkler wirkt als der Blender-Render: gebacken wird die Grundfarbe,
// nicht das beleuchtete Bild. Der metallische Eindruck entsteht hier unten ueber specular -
// steckte er schon in der Textur, waere er im Spiel doppelt drin und das Modell wuerde
// flach und milchig aussehen.
//
// Zum Nachdrehen: specular hoch = mehr Reflexion, specularPower hoch = kleineres, haerteres
// Glanzlicht. Die erste Zahl im Fresnel steuert den hellen Rand an der Silhouette.

class StageTI {
    texture = "a3\data_f\default_ti_ca.paa";
};

ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={0,0,0,1};
specular[]={0.14,0.145,0.155,1};
specularPower=36;
PixelShaderID="Super";
VertexShaderID="Super";

class Stage1 {
    // Kein fuehrender Backslash: beim mainprefix z loest Arma "\z\opw\..." nicht auf,
    // "z\opw\..." dagegen schon. Das ist belegt - beim alten Stab luden genau die Pfade
    // mit Backslash nicht.
    texture = "z\opw\addons\esdcam\data\camhead_nohq.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage2 {
    texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,dt)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage3 {
    texture = "#(argb,8,8,3)color(0,0,0,0,mc)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage4 {
    // Keine Ambient-Occlusion-Textur gebacken, also neutral weiss.
    texture = "#(argb,8,8,3)color(1,1,1,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,1};
    };
};

class Stage5 {
    // SMDI neutral. Wer spaeter eine echte Specular-Map backt, haengt sie hier ein.
    texture = "#(argb,8,8,3)color(1,1,1,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage6 {
    texture = "#(ai,64,64,1)fresnel(0.35,0.7)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};

class Stage7 {
    // Schwarz statt env_land_ca: ein glattes Rohr mit Umgebungsspiegelung kippt auf der
    // weissen VR-Karte sofort in Chrom. Das war beim alten Stab schon einmal das Problem.
    texture = "#(argb,8,8,3)color(0,0,0,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};
