// Material of the camera attachment.
//
// The maps come from the Blender bake of the wand model (art/esdcam/), which arrived as
// one 4096 set per material - Plastik, Schlauch, blitz, cam - over a single shared UV
// layout. tools/bake_textures.py folds those four into the one set this file names, by
// rasterising each material's UV islands and taking that material's bake inside them.
//
// So there is one texture set and one rvmat for the whole wand, and the difference
// between matte body, ribbed hose and lens is carried by the maps rather than by four
// separate materials.
//
// Channel conventions are Bohemia's, and the bake already follows them: _smdi keeps the
// specular level and power in green and blue, _as is read from green alone. Both are
// passed through untouched - the numbers below only scale what is in them.
//
// To adjust: higher specular means more reflection, higher specularPower a smaller and
// harder highlight. The first number in the fresnel drives the bright rim at the
// silhouette. Anything that should differ per part of the model belongs in the bake, not
// here.

class StageTI {
    texture = "a3\data_f\default_ti_ca.paa";
};

ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={0,0,0,1};
// Turned down from 0.14/36 after the model read as white piping along every bevel in game.
// The base and the flange are a stack of concentric chamfered rings, and on a body that is
// otherwise a flat colour every one of those catches the light and draws itself as a bright
// line. Less specular and a wider highlight spread that out; the _smdi keeps the hose and
// the lens where they were, since the numbers here only scale what is in the map.
specular[]={0.06,0.062,0.067,1};
specularPower=14;
PixelShaderID="Super";
VertexShaderID="Super";

class Stage1 {
    // No leading backslash: with mainprefix z, Arma resolves "z\opw\..." but not
    // "\z\opw\...". A leading backslash here means the texture silently fails to load.
    texture = "z\opw\addons\esdcam\data\camhead_nohq.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage2 {
    texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,dt)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage3 {
    // No macro texture. The bake writes a _mc file, but it is a byte for byte copy of
    // the colour map, which is not what a macro map is for - so this stays procedural.
    texture = "#(argb,8,8,3)color(0,0,0,0,mc)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage4 {
    // Ambient shadow, baked. The fill outside the UV islands is white rather than the
    // bake's own black background: black there would creep in through the mip chain and
    // show as a dirty edge all round the silhouette.
    texture = "z\opw\addons\esdcam\data\camhead_as.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,1};
    };
};

class Stage5 {
    // Specular, baked: the body reads matte, the hose picks up a sheen, and the lens and
    // the LEDs at the head are the brightest thing on the model.
    texture = "z\opw\addons\esdcam\data\camhead_smdi.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage6 {
    // Down from fresnel(0.35,0.7) for the same reason as the specular above: the first
    // number is what lights the silhouette, and on a dark matte body a strong one outlines
    // every edge in white. This is the knob to reach for first if the model still reads as
    // if someone had drawn round it.
    texture = "#(ai,64,64,1)fresnel(0.15,0.5)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};

class Stage7 {
    // Black rather than env_land_ca: a smooth tube with environment reflection tips straight
    // into chrome, most visibly on bright terrain.
    texture = "#(argb,8,8,3)color(0,0,0,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};
