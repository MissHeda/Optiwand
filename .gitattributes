# Nail down line endings.
#
# Without this Git converts to CRLF on checkout under Windows. That is bad for Arma
# configs and for the Python scripts here: the preprocessor and the Blender scripts
# expect LF, and a mixed tree makes every diff unreadable.
* text=auto eol=lf

# Never touch binaries
*.p3d       binary
*.paa       binary
*.pbo       binary
*.bisign    binary
*.bikey     binary
*.png       binary
*.jpg       binary
*.rar       binary
*.zip       binary
*.blend     binary
*.rtm       binary

# These are text, even though the extension is unusual
*.sqf       text eol=lf
*.hpp       text eol=lf
*.cpp       text eol=lf
*.rvmat     text eol=lf
*.inc       text eol=lf
