// Material der Bildschirmflaeche (Named Selection "screen").
//
// Die Textur selbst steht hier absichtlich nicht drin - die kommt aus CfgWeapons ueber
// hiddenSelectionsTextures und ist das Render-Target der Spiegelkamera.
//
// Der Trick ist forcedDiffuse: ambient und diffuse auf 0, forcedDiffuse auf 1. Damit wird
// das Bild unabhaengig von der Beleuchtung in voller Helligkeit gezeichnet, so wie ein
// Bildschirm eben leuchtet. Mit einem normalen Material waere das Kamerabild in einem
// dunklen Treppenhaus praktisch schwarz.
//
// Falls der Bildschirm ingame zu grell oder zu flau wirkt: an forcedDiffuse drehen,
// {0.8,0.8,0.8,1} ist ein guter erster Schritt nach unten.

ambient[]={0,0,0,1};
diffuse[]={0,0,0,1};
forcedDiffuse[]={1,1,1,1};
emmisive[]={0,0,0,1};
specular[]={0,0,0,0};
specularPower=1;
PixelShaderID="Normal";
VertexShaderID="Basic";

class Stage1 {
    texture = "#(argb,8,8,3)color(0.5,0.5,1,1,nohq)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};
