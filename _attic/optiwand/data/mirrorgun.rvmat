// Uebernommen aus Data\mirrorgun.rvmat, mit drei Korrekturen:
//   - die Pfade zeigten auf \MirrorgunKKC\Data\MirrorgunKKC_*, einen Ordner den es nie gab
//   - die Dateien heissen in Wirklichkeit mirrorgun_*
//   - kein fuehrender Backslash: beim mainprefix z loest Arma "\z\opw\..." nicht auf,
//     "z\opw\..." dagegen schon. Belegt durch die RPT - die co-Textur kommt aus der p3d
//     ohne Backslash und laedt, die drei hier mit Backslash luden nicht.
// Stage2, Stage3, Stage6 und Stage7 sind prozedural bzw. Engine-Texturen und bleiben.
//
// Glanz zurueckgedreht. Das Original kam mit specular 0.16 / specularPower 22 und einem
// harten Fresnel (4.7, 1.2). Zusammen mit der Environment-Map in Stage7 spiegelte der Stab
// den Himmel und sah aus wie poliertes Chrom - auf der weissen VR-Karte besonders extrem.
// Die Grundtextur selbst ist mattes Dunkelgrau, also gehoert der Glanz auch dahin.
// Zum Nachdrehen: specular hoch = mehr Reflexion, specularPower hoch = kleineres Glanzlicht,
// die erste Zahl im Fresnel hoch = staerkerer Reflexionsrand.
//
// Zweiter Durchgang, nachdem die smdi angeschaut wurde: die ist praktisch ueberall
// vollgesaettigt - offenbar die eingefaerbte Farbtextur, keine echte Specular-Map. Solange
// die den Glanz treibt, bringt Feintuning nichts. Also wurden die Reflexionsquellen selbst
// stillgelegt:
//   - specular fast auf Null: der Faktor multipliziert den gesamten Glanzanteil, damit ist
//     die kaputte smdi wirkungslos
//   - Stage7 auf Schwarz statt a3\data_f\env_land_ca.paa: keine Himmelsspiegelung mehr
//   - Fresnel fast aus: der helle Rand war der halbe Chromeffekt
// Uebrig bleibt mattes Material mit der Normal Map als einziger Struktur. Wer spaeter eine
// richtige smdi malt, dreht specular wieder hoch und holt env_land_ca zurueck.

class StageTI {
    texture = "a3\data_f\default_ti_ca.paa";
};

ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={0,0,0,1};
specular[]={0.015,0.015,0.015,1};
specularPower=6;
PixelShaderID="Super";
VertexShaderID="Super";

class Stage1 {
    texture = "z\opw\addons\optiwand\data\mirrorgun_nohq.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage2 {
    texture = "#(argb,8,8,3)color(0.5,0.5,0.5,1,dt)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage3 {
    texture = "#(argb,8,8,3)color(0,0,0,0,mc)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage4 {
    texture = "z\opw\addons\optiwand\data\mirrorgun_as.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,1};
    };
};

class Stage5 {
    texture = "z\opw\addons\optiwand\data\mirrorgun_smdi.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,0};
        pos[] = {0,0,0};
    };
};

class Stage6 {
    texture = "#(ai,64,64,1)fresnel(0.3,0.6)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};

class Stage7 {
    texture = "#(argb,8,8,3)color(0,0,0,1)";
    uvSource = "tex";
    class uvTransform {
        aside[] = {1,0,0};
        up[] = {0,1,0};
        dir[] = {0,0,1};
        pos[] = {0,0,0};
    };
};
